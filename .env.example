# BitMart SDK example credentials & endpoint.
# Copy this file to `.env` (git-ignored) at the project root and fill in real values.
# Loaded by examples/config.js with priority: .env file > process.env > placeholder defaults.

BITMART_API_KEY=your_api_key
BITMART_SECRET_KEY=your_api_secret
BITMART_MEMO=your_api_memo

# REST API base URL (optional).
# Spot default:    https://api-cloud.bitmart.com
# Futures default: https://api-cloud-v2.bitmart.com
BITMART_API_URL=
